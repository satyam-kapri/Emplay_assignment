# Copy to .env; never commit credentials.
RFP_DATA_DIR=.data
RFP_OUTPUT_DIR=outputs
RFP_DATA_ROOT=.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RFP_SEARCH_MODE=hybrid
# Uses an OpenAI-compatible chat-completions endpoint, including compatible local servers.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=60
RFP_CONCURRENCY=3
RFP_REPAIR_ATTEMPTS=2
